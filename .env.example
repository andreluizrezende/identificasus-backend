NODE_ENV=development
PORTA=3000

# Banco dbsamu (MySQL 8.4). Em producao, um usuario por finalidade (ADR-14):
# nri_assistencial, nri_adjudicacao, nri_auditoria, nri_pesquisa, nri_indicadores.
DATABASE_URL="mysql://nri_assistencial:trocar@localhost:3306/dbsamu"
# Conexoes por pool, por finalidade
BANCO_CONEXOES=10
DATABASE_URL_AUDITORIA="mysql://nri_auditoria:trocar@localhost:3306/dbsamu"
DATABASE_URL_ADMINISTRACAO="mysql://nri_administracao:trocar@127.0.0.1:3306/dbsamu"
DATABASE_URL_PESQUISA="mysql://nri_pesquisa:trocar@localhost:3306/dbsamu"

# Keycloak (OIDC). A claim `purpose` do token carrega a finalidade.
OIDC_ISSUER=http://localhost:8080/realms/identificasus
OIDC_JWKS_URI=http://localhost:8080/realms/identificasus/protocol/openid-connect/certs
OIDC_AUDIENCE=identificasus-api
# Cliente publico do aplicativo de campo. Concessao direta: a senha passa pelo
# backend e nao para nele. O porque esta em keycloak/LEIA-ME.md.
OIDC_CLIENT_ID=identificasus-app

# RabbitMQ - outbox e reenvio das integracoes externas
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Trava anterior a aprovacao do CEP (RNF-05.02): com 0, o sistema
# so opera sobre dados sinteticos.
CEP_APROVADO=0

# ---------------------------------------------------------------------
# Recuperacao de senha ("perdi minha senha")
# ---------------------------------------------------------------------
# Canal de entrega do codigo. `console` so e aceito em desenvolvimento:
# imprimir o codigo no log e vazamento em qualquer outro lugar.
CORREIO_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IdentificaSUS <nao-responda@saude.salvador.ba.gov.br>"

# Quem guarda a credencial e o Keycloak (ADR-09). A troca da senha usa a API
# administrativa dele; sem estas variaveis, o passo 2 responde 503 em vez de
# criar um segundo armazenamento de senha no dbsamu.
KEYCLOAK_REALM=identificasus
KEYCLOAK_ADMIN_CLIENT_ID=identificasus-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Fotos (Vercel Blob, store identificasus-fotos)
# ---------------------------------------------------------------------
# O binario nunca passa pelo backend: o aparelho pede um token em
# POST /midia/upload e envia a foto direto pro Blob. Na Vercel, a Vercel
# injeta esta variavel sozinha (projeto ja conectado ao store); para dev
# local, `vercel env pull` traz o valor de verdade.
BLOB_READ_WRITE_TOKEN=
