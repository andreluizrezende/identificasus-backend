{
  "name": "identificasus-backend",
  "version": "0.1.0",
  "private": true,
  "description": "IdentificaSUS - Nucleo de Resolucao de Identidade (API)",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:estrutura": "mysql --defaults-group-suffix=identificasus < db/01_estrutura.sql",
    "db:recuperacao": "mysql --defaults-group-suffix=identificasus < db/03_recuperacao_de_senha.sql",
    "db:usuarios": "mysql --defaults-group-suffix=identificasus < db/02_usuarios_por_finalidade.sql",
    "criar-administrador": "node --import tsx scripts/criar-administrador.ts",
    "test:banco": "vitest run --config vitest.banco.config.ts",
    "db:homologacao": "mysql --defaults-group-suffix=identificasus < db/04_homologacao.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@vercel/blob": "^2.8.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
